# Pipeline reproducible: benchmark naive de multiplicación de matrices NxN
# en C++, Go, Java y Python.
#
# Requisito previo: construir MANUALMENTE las imágenes (ver README.md, sección 8):
#   docker build -f docker/<lang>/Dockerfile -t matmul-<lang>:1.0 .
#
# Ejecución completa (desde la raíz del repositorio):
#   snakemake                                  # usa workflow/profiles/default
#   snakemake --config engine=podman           # con Podman en vez de Docker
#   .venv\Scripts\snakemake                    # Windows (PowerShell + Docker Desktop)
#
# Grafo de dependencias:
#   run_benchmark (x4) ─► merge ─► analysis ─► tablas/figuras/reporte
#                     └─► verify_equivalence
#   environment (registro del entorno)
#
# Cada regla comprueba antes de ejecutarse que su imagen exista localmente
# (sin archivos marca: así reconstruir el reporte no obliga a repetir los benchmarks).

import os
import shlex
import subprocess
import sys

from snakemake.exceptions import WorkflowError

configfile: "config/config.yaml"

ENGINE = config["engine"]
TAG = str(config["image_tag"])
LANGS = list(config["languages"])
SIZES = ",".join(str(n) for n in config["sizes"])
REPS = int(config["repetitions"])
SEED = int(config["seed"])
ALPHA = float(config["alpha"])
R = config["results_dir"]

# Los contenedores se lanzan con subprocess (sin shell), de modo que el mismo Snakefile
# funciona en Linux, macOS y Windows (Docker Desktop), incluso con espacios en las rutas.
MOTOR = shlex.split(ENGINE)
ES_WINDOWS = os.name == "nt"


def opciones_usuario():
    """Opciones para que los archivos generados pertenezcan al usuario del host.

    En Windows (Docker Desktop) no aplican: los archivos montados ya son del usuario.
    """
    if ES_WINDOWS:
        return []
    if os.path.basename(MOTOR[0]).startswith("podman"):
        return ["--userns=keep-id"]
    return ["--user", f"{os.getuid()}:{os.getgid()}"]


def volumen(ruta_host, ruta_contenedor):
    """Montaje de un directorio del host; ':z' reetiqueta para SELinux (Fedora/RHEL)."""
    sufijo = "" if ES_WINDOWS else ":z"
    return ["-v", f"{os.path.abspath(ruta_host)}:{ruta_contenedor}{sufijo}"]


def requiere_imagen(img):
    """Falla con un mensaje claro si la imagen no fue construida localmente.

    No se permite descargar imágenes del benchmark desde registros (Docker Hub, GHCR, etc.).
    """
    nombre = f"matmul-{img}:{TAG}"
    inspeccion = subprocess.run(
        MOTOR + ["image", "inspect", nombre],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    if inspeccion.returncode != 0:
        raise WorkflowError(
            f"Falta la imagen {nombre}. Constrúyala manualmente:\n"
            f"  {ENGINE} build -f docker/{img}/Dockerfile -t {nombre} ."
        )


def ejecutar(cmd, log=None):
    """Ejecuta un comando, lo muestra y (opcionalmente) guarda su stderr en un log."""
    print("$ " + " ".join(shlex.quote(c) for c in cmd), file=sys.stderr)
    if log is None:
        subprocess.run(cmd, check=True)
    else:
        with open(log, "w", encoding="utf-8") as f:
            subprocess.run(cmd, check=True, stderr=f)


def analisis(*args):
    """Ejecuta un script de scripts/ dentro de la imagen de análisis (versiones fijadas)."""
    requiere_imagen("analysis")
    rutas = [str(a).replace("\\", "/") for a in args]  # rutas POSIX dentro del contenedor
    ejecutar(
        MOTOR + ["run", "--rm"] + opciones_usuario() + ["--network", "none"]
        + volumen(".", "/work") + ["-w", "/work", f"matmul-analysis:{TAG}", "python"] + rutas
    )


rule all:
    input:
        f"{R}/benchmark.csv",
        f"{R}/verification/equivalence_report.md",
        f"{R}/analysis/reporte_estadistico.md",
        f"{R}/environment/environment.md",


# Ejecuta el contenedor de un lenguaje: genera <lang>.csv y su checksum.
# El recurso 'benchmark_slot=1' (perfil por defecto) impide ejecutar dos
# benchmarks en paralelo, evitando la contención de CPU entre lenguajes.
rule run_benchmark:
    output:
        csv=f"{R}/raw/{{lang}}.csv",
        checksum=f"{R}/verification/{{lang}}_checksum.csv",
    log:
        f"{R}/logs/{{lang}}.log",
    resources:
        benchmark_slot=1,
    run:
        lang = wildcards.lang
        requiere_imagen(lang)
        ejecutar(
            MOTOR + ["run", "--rm"] + opciones_usuario() + ["--network", "none"]
            + volumen(R, "/results")
            + [f"matmul-{lang}:{TAG}", f"/results/raw/{lang}.csv", SIZES, str(REPS), str(SEED),
               f"/results/verification/{lang}_checksum.csv"],
            log=log[0],
        )


# Integra los cuatro CSV en benchmark.csv (dentro del contenedor de análisis).
rule merge:
    input:
        csvs=expand(f"{R}/raw/{{lang}}.csv", lang=LANGS),
    output:
        f"{R}/benchmark.csv",
    run:
        analisis("scripts/merge_results.py", output[0], *input.csvs)


# Comprueba que las cuatro implementaciones producen la misma matriz resultado.
rule verify_equivalence:
    input:
        checksums=expand(f"{R}/verification/{{lang}}_checksum.csv", lang=LANGS),
    output:
        f"{R}/verification/equivalence_report.md",
    run:
        analisis("scripts/verify_equivalence.py", output[0], *input.checksums)


# ANOVA de dos factores con interacción, Tukey HSD, tablas y gráficos.
rule analysis:
    input:
        bench=f"{R}/benchmark.csv",
    output:
        report=f"{R}/analysis/reporte_estadistico.md",
        descriptivos=f"{R}/analysis/tables/descriptivos.csv",
        anova=f"{R}/analysis/tables/anova_tiempo.csv",
        tukey=f"{R}/analysis/tables/tukey_lenguaje_por_N_log.csv",
        boxplot=f"{R}/analysis/figures/boxplot_tiempos.png",
        interaccion=f"{R}/analysis/figures/interaccion_lenguaje_N.png",
    run:
        analisis("scripts/analysis.py", input.bench, f"{R}/analysis", ALPHA)


# Registra hardware, sistema operativo y versiones de compiladores/VM.
rule environment:
    output:
        f"{R}/environment/environment.md",
    run:
        ejecutar([sys.executable, "scripts/collect_env.py", output[0], ENGINE, TAG])
